# Optional alternative provider. Set only one model-provider key.
OPENAI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEATLOGS_PROJECT=showonce
NEATLOGS_PROJECT_KEY=
NEATLOGS_API_KEY=
NEATLOGS_MCP_URL=https://ingest.neatlogs.com/mcp
# Create the bot from slack_manifest.json, then /invite it to the channel. Verify with: python cli.py check
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#showonce-demo
# Only messages containing this word are treated as bug reports
SLACK_TRIGGER=bug
LINEAR_API_KEY=
# Optional; defaults to the first team the API key can see
LINEAR_TEAM_ID=
# Optional: Microsoft Teams incoming/Workflows webhook for the "code has been fixed" message
TEAMS_WEBHOOK_URL=
